# Copy to .env and fill in (do not commit .env).
# Used by the xurrent-mcp server and local integration tests.

# --- Xurrent API (required) ---
# Personal access token or OAuth bearer token (see https://developer.xurrent.com/v1/)
XURRENT_TOKEN=

# Account ID for X-Xurrent-Account header
XURRENT_ACCOUNT=

# Optional: override API base URL
# XURRENT_API_BASE=https://api.xurrent.com

# Optional: language header (e.g. en-US, nl)
# XURRENT_LANGUAGE=

# --- Mutations ---
# Set to 1 to enable create/update/delete tools.
# Without this, only read tools are available.
# XURRENT_ALLOW_MUTATIONS=0

# --- Rate limiting ---
# Minimum seconds between API calls (default 0.4).
# XURRENT_HTTP_MIN_INTERVAL=0.4

# --- MCP transport ---
# stdio = local (Claude Desktop / Cursor)
# http  = Docker / remote deployments
# MCP_TRANSPORT=stdio

# --- Server ---
# HTTP port (default 8080)
# PORT=8080

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Log format: json (default) or text
# LOG_FORMAT=json

# --- Tool output ---
# Max characters per tool response (default 120000)
# XURRENT_TOOL_MAX_RESPONSE_CHARS=120000

# Set to 0 for human-readable (non-compact) JSON
# XURRENT_TOOL_JSON_COMPACT=1

# --- Live find (collision detection) ---
# Max cursor pages per list for find_identifier_candidates (default 50, max 500)
# XURRENT_LIVEFIND_MAX_PAGES=50

# --- OTEL (optional, build tag: otel) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=xurrent-mcp
